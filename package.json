{
  "name": "opencompass",
  "private": true,
  "version": "0.0.0",
  "description": "OpenCompass — open education for humans in the age of AI",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "compile": "tsx scripts/compile-ontology.ts",
    "lint:content": "tsx scripts/compile-ontology.ts --check",
    "dev": "pnpm --filter @opencompass/web dev",
    "build": "pnpm compile && pnpm --filter @opencompass/web build",
    "build:web": "pnpm --filter @opencompass/web build",
    "check:ask": "pnpm --filter @opencompass/web check:ask"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "ajv": "^8.17.1",
    "gray-matter": "^4.0.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"]
  }
}
